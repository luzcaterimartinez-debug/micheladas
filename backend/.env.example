# =============================================================================
# Michelandia API — desarrollo local
# Copia a .env:  copy .env.example .env
# =============================================================================

APP_ENV=development

# Zona horaria del negocio (Colombia). El API también fija MySQL a -05:00.
TZ=America/Bogota

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=michelada

MYSQL_POOL_SIZE=5
MYSQL_CONNECTION_TIMEOUT=10
QUERY_CACHE_TTL_SECONDS=45
QUERY_CACHE_COMANDAS_TTL_SECONDS=8
QUERY_CACHE_AUTH_TTL_SECONDS=300
QUERY_CACHE_CAJA_TTL_SECONDS=10
QUERY_CACHE_INVENTARIO_TTL_SECONDS=30
QUERY_CACHE_MESAS_TTL_SECONDS=15
QUERY_CACHE_REPORTES_TTL_SECONDS=60
QUERY_CACHE_GASTOS_TTL_SECONDS=30
QUERY_CACHE_MENU_TTL_SECONDS=120

# Genera uno seguro: python -c "from app.config import generate_jwt_secret; print(generate_jwt_secret())"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRE_MINUTES=10080

# Orígenes del frontend (separados por coma, sin espacios extra)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
