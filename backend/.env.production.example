# =============================================================================
# Michelandia API — PRODUCCIÓN
# Copia a .env en el servidor (nunca subas .env a git).
# =============================================================================

APP_ENV=production

# --- MySQL (Hostinger, RDS, servidor propio) ---
MYSQL_HOST=tu-host.mysql.example.com
MYSQL_PORT=3306
MYSQL_USER=michelada_app
MYSQL_PASSWORD=contraseña-larga-y-única
MYSQL_DATABASE=michelada

MYSQL_POOL_SIZE=1
MYSQL_CONNECTION_TIMEOUT=8
# Caché en memoria (por instancia Vercel). TTLs altos + stale-on-error = POS no se cae.
QUERY_CACHE_TTL_SECONDS=90
QUERY_CACHE_COMANDAS_TTL_SECONDS=20
QUERY_CACHE_AUTH_TTL_SECONDS=600
QUERY_CACHE_CAJA_TTL_SECONDS=25
QUERY_CACHE_INVENTARIO_TTL_SECONDS=60
QUERY_CACHE_MESAS_TTL_SECONDS=30
QUERY_CACHE_REPORTES_TTL_SECONDS=120
QUERY_CACHE_GASTOS_TTL_SECONDS=60
QUERY_CACHE_MENU_TTL_SECONDS=300
QUERY_CACHE_NOMINA_TTL_SECONDS=90

# Obligatorio en producción: mínimo 32 caracteres aleatorios
# Generar: python -c "from app.config import generate_jwt_secret; print(generate_jwt_secret())"
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# Solo dominios reales del frontend (HTTPS)
CORS_ORIGINS=https://tu-dominio.vercel.app,https://pos.tu-negocio.com
